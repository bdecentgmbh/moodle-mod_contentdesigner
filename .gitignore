# The paid elements and addons live in private repositories and are wired in as git submodules (see
# .gitmodules). Git only records the submodule commit here, never their code. Any other directory under
# cdelement/ or cdaddon/ is ignored, so paid code can never be committed to this repository by accident:
# list a new free element here when you add it.
/cdelement/*/
!/cdelement/callout/
!/cdelement/chapter/
!/cdelement/h5p/
!/cdelement/heading/
!/cdelement/outro/
!/cdelement/panels/
!/cdelement/paragraph/
!/cdelement/richtext/
!/cdelement/image/
!/cdelement/poll/
!/cdelement/question/
!/cdelement/rating/
!/cdelement/tableofcontents/
!/cdelement/videotime/
/cdaddon/*/
!/cdaddon/pro/
!/cdaddon/report/

# Generated by Moodle and the tools.
/phpunit.xml
.phpunit.cache/
node_modules/

# Generated by the operating systems and editors.
.DS_Store
Thumbs.db
.idea/
