# Left out of the release ZIP (git archive), also by Moodle HQ's release workflow.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitmodules export-ignore

# The paid elements and addons are private submodules. Keep their empty placeholders out of source archives (git
# archive, the zips of GitHub releases), where Moodle would report them as plugins with a missing version.php. List a
# new paid element here when you add its submodule; the free elements (chapter, h5p, heading, image, outro, paragraph,
# richtext, tableofcontents, videotime) are part of the archive.
/cdelement/panels export-ignore
/cdelement/poll export-ignore
/cdelement/question export-ignore
/cdelement/rating export-ignore
/cdaddon/* export-ignore
/cdaddon/README.md -export-ignore
